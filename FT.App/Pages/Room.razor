@page "/room"
@inherits SessionPage

<PageTitle>탈의실 · Football Tactician</PageTitle>

@if (Session.World is not { } w || w.MyClub is not { } club || Session.Room is not { } room)
{
    <Redirect />
}
else
{
    var squad = w.Squad(club.id).OrderByDescending(Session.InfluenceOf).ToList();
    var grievances = Session.Grievances;

    <h1>탈의실</h1>
    <p class="muted">
        분위기는 선수들의 사기가 돌아가는 기준선을 정하고, 사기는 경기력에 들어갑니다.
    </p>

    <div class="grid grid-4">
        <div class="stat">
            <div class="stat-label">화합도</div>
            <div class="stat-value @Tone(room.overallHarmony)">@room.overallHarmony.ToString("F0")</div>
            <div class="stat-sub">@HarmonyWord(room.overallHarmony)</div>
        </div>
        <div class="stat">
            <div class="stat-label">불만</div>
            <div class="stat-value @(room.discontent > 30 ? "bad" : "")">@room.discontent.ToString("F0")</div>
            <div class="stat-sub">@(grievances.Count)건</div>
        </div>
        <div class="stat">
            <div class="stat-label">리더십</div>
            <div class="stat-value">@room.leadershipStrength.ToString("F0")</div>
            <div class="stat-sub">@(w.Player(room.captainPlayerId)?.FullName ?? "—")</div>
        </div>
        <div class="stat">
            <div class="stat-label">사기 기준선</div>
            <div class="stat-value">@DressingRoom.MoraleAnchorFor(club).ToString("F0")</div>
            <div class="stat-sub">
                평균 @w.Squad(club.id).Average(p => p.morale).ToString("F0")
            </div>
        </div>
    </div>

    @if (Session.PendingRequests is { Count: > 0 } requests)
    {
        <div class="card">
            <div class="card-head">
                <h3>이적 요청</h3>
                <span class="spacer"></span>
                <span class="tiny dim">받아들이든 거절하든 대가가 있습니다</span>
            </div>

            <table class="ft">
                <tbody>
                    @foreach (var (p, req) in requests)
                    {
                        <tr>
                            <td class="nowrap" style="width:11rem">
                                <a href="@($"player/{p.id}")">@p.FullName</a>
                                @if (Session.RejectionsOf(p.id) > 0)
                                {
                                    <span class="badge warn">@(Session.RejectionsOf(p.id))번 거절</span>
                                }
                            </td>
                            <td>
                                “@req.reason”
                                <div class="tiny dim">
                                    올해 @(p.seasonStats?.appearances ?? 0)경기 · 사기 @p.morale.ToString("F0")
                                </div>
                            </td>
                            <td class="right nowrap" style="width:11rem">
                                <button class="btn btn-sm" @onclick="() => Accept(p.id)">보내 주기</button>
                                <button class="btn btn-sm btn-ghost" @onclick="() => Reject(p.id)">붙잡기</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <p class="tiny dim">
                보내 주면 사기를 되찾지만 이적 명단에 올라 호가가 내려갑니다.
                붙잡으면 당장 지키지만 사기가 떨어지고, 거듭 거절할수록 다음 요청이 빨리 옵니다.
            </p>
        </div>
    }

    @if (Session.CalledUp is { Count: > 0 } called)
    {
        <div class="card">
            <div class="card-head">
                <h3>국가대표</h3>
                <span class="spacer"></span>
                <span class="tiny dim">@(called.Count)명 소집 대상</span>
            </div>

            <table class="ft">
                <tbody>
                    @foreach (var p in called)
                    {
                        <tr>
                            <td class="nowrap" style="width:11rem">
                                <a href="@($"player/{p.id}")">@p.FullName</a>
                            </td>
                            <td class="tiny dim"><Flag Of="p.nationality" /> @p.nationality · @(p.caps)경기 @(p.internationalGoals)골</td>
                            <td class="right mono tiny" style="width:5rem">
                                컨디션 @p.condition.ToString("F0")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <p class="tiny dim">
                A매치 주간에 불려 나가 지쳐서 돌아옵니다. 막을 수 없으니 스쿼드를 깊게 두세요.
            </p>
        </div>
    }

    <div class="card">
        <div class="card-head">
            <h3>불만</h3>
            <span class="spacer"></span>
            <span class="tiny dim">모두 감독이 손댈 수 있는 것들입니다</span>
        </div>

        @if (grievances.Count == 0)
        {
            <p class="tiny dim">불만이 없습니다.</p>
        }
        else
        {
            <table class="ft">
                <tbody>
                    @foreach (var g in grievances.Take(12))
                    {
                        var p = w.Player(g.PlayerId);
                        <tr>
                            <td class="nowrap" style="width:12rem">
                                <a href="@($"player/{g.PlayerId}")">@p?.FullName</a>
                            </td>
                            <td>@g.Reason</td>
                            <td class="right mono dim tiny" style="width:3rem">@g.weight.ToString("F0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <div class="card-head">
            <h3>영향력</h3>
            <span class="spacer"></span>
            <span class="tiny dim">나이 · 실력 · 리더십</span>
        </div>

        <table class="ft">
            <thead>
                <tr>
                    <th>선수</th>
                    <th class="center">나이</th>
                    <th class="center">CA</th>
                    <th class="center">리더십</th>
                    <th class="center">영향력</th>
                    <th class="center">역할</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in squad.Take(12))
                {
                    <tr class="@(p.id == room.captainPlayerId ? "me" : "")">
                        <td class="nowrap"><a href="@($"player/{p.id}")">@p.FullName</a></td>
                        <td class="center">@w.Age(p)</td>
                        <td class="center mono">@GameWorld.Ca(p).ToString("F0")</td>
                        <td class="center mono">@(p.mental?.leadership ?? 0)</td>
                        <td class="center mono">@Session.InfluenceOf(p).ToString("F0")</td>
                        <td class="center">
                            @if (p.id == room.captainPlayerId)
                            {
                                <span class="badge good">주장</span>
                            }
                            else if (p.id == room.viceCaptainPlayerId)
                            {
                                <span class="badge">부주장</span>
                            }
                            else if (room.influencerPlayerIds.Contains(p.id))
                            {
                                <span class="badge">핵심</span>
                            }
                        </td>
                        <td class="right">
                            @if (p.id != room.captainPlayerId)
                            {
                                <button class="btn btn-sm" @onclick="() => SetCaptain(p.id)">주장으로</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="tiny dim">
            영향력이 낮은 선수를 주장으로 세우면 리더십이 떨어지고 분위기가 나빠집니다.
        </p>
    </div>

    <div class="card">
        <div class="card-head">
            <h3>관계</h3>
            <span class="spacer"></span>
            <select class="input input-sm" @bind="viewPlayerId">
                @foreach (var p in squad)
                {
                    <option value="@p.id">@p.FullName</option>
                }
            </select>
        </div>

        @{
            var subject = w.Player(viewPlayerId) ?? squad.FirstOrDefault();
        }
        @if (subject is null)
        {
            <p class="tiny dim">선수가 없습니다.</p>
        }
        else
        {
            var relations = Session.RelationsOf(subject);
            <p class="tiny dim">@subject.FullName (@w.Age(subject)세) 를 둘러싼 관계입니다.</p>

            @if (relations.Count == 0)
            {
                <p class="tiny dim">이렇다 할 관계가 없습니다.</p>
            }
            else
            {
                <table class="ft">
                    <tbody>
                        @foreach (var rel in relations.Take(10))
                        {
                            var other = w.Player(rel.targetPlayerId);
                            <tr>
                                <td class="nowrap" style="width:9rem">
                                    <span class="badge @RelClass(rel.type)">@RelName(rel.type)</span>
                                </td>
                                <td class="nowrap"><a href="@($"player/{rel.targetPlayerId}")">@other?.FullName</a></td>
                                <td class="dim tiny">@RelWhy(rel.type)</td>
                                <td class="right mono dim tiny" style="width:3rem">@rel.strength</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
}

@code {
    int viewPlayerId;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        viewPlayerId = Session.Room?.captainPlayerId ?? 0;
    }

    async Task SetCaptain(int id) => await Session.SetCaptainAsync(id);
    async Task Accept(int id) => await Session.AcceptRequestAsync(id);
    async Task Reject(int id) => await Session.RejectRequestAsync(id);

    static string Tone(float harmony) => harmony >= 65 ? "accent" : harmony < 45 ? "bad" : "";

    static string HarmonyWord(float h) => h switch
    {
        >= 75 => "하나로 뭉쳐 있음",
        >= 60 => "원만함",
        >= 45 => "평범함",
        >= 30 => "삐걱거림",
        _ => "갈라져 있음",
    };

    static string RelName(RelationshipType t) => t switch
    {
        RelationshipType.Captain => "주장",
        RelationshipType.Mentor => "멘토",
        RelationshipType.Mentee => "멘티",
        RelationshipType.Rival => "경쟁자",
        RelationshipType.NationalTeam => "동향",
        RelationshipType.Friend => "친한 동료",
        RelationshipType.Dislike => "비호감",
        RelationshipType.Conflict => "갈등",
        _ => "동료",
    };

    static string RelClass(RelationshipType t) => t switch
    {
        RelationshipType.Captain => "good",
        RelationshipType.Rival or RelationshipType.Dislike or RelationshipType.Conflict => "warn",
        _ => "",
    };

    static string RelWhy(RelationshipType t) => t switch
    {
        RelationshipType.Captain => "팀을 이끄는 선수",
        RelationshipType.Mentor => "나이와 경험이 앞서 이끌어 줍니다",
        RelationshipType.Mentee => "어린 선수를 이끌어 주고 있습니다",
        RelationshipType.Rival => "같은 자리를 비슷한 실력으로 다툽니다",
        RelationshipType.NationalTeam => "같은 나라 출신입니다",
        _ => "",
    };
}
