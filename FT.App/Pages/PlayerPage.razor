@page "/player/{Id:int}"
@inherits SessionPage

<PageTitle>@(Player?.FullName ?? "선수") · Football Tactician</PageTitle>

@if (Session.World is not { } w)
{
    <Redirect />
}
else if (Player is not { } p)
{
    <div class="empty">선수를 찾을 수 없습니다. <a href="squad">스쿼드로</a></div>
}
else
{
    var ca = GameWorld.Ca(p);
    var pa = PlayerDevelopment.Pa(p);
    var club = w.Club(p.clubId);

    <h1>@p.FullName</h1>
    <p class="muted">
        <span class="badge pos @Ui.PosClassOf(p)">@Ui.PosLabelOf(p)</span>
        @if (club is not null) { <ClubLink Id="club.id" Kit="true" /> } else { <span>자유 계약</span> } · @(w.Age(p))세 · <Flag Of="p.nationality" /> @Ui.NationCode(p.nationality) · @p.height cm / @p.weight kg ·
        @(p.preferredFoot == PreferredFoot.Left ? "왼발" : p.preferredFoot == PreferredFoot.Right ? "오른발" : "양발")
        @if (p.transferStatus == TransferStatus.ListedForTransfer) { <span class="badge warn">이적 명단</span> }
        @if (w.OnLoan(p.id) != null) { <span class="badge">임대 중</span> }
    </p>

    <PlayerActions Player="p" />

    @if (p.IsInjured)
    {
        <div class="card" style="border-color:var(--coral)">
            <strong style="color:var(--coral)">@p.injury!.injuryType</strong>
            <span class="muted">
                · @Ui.SeverityLabel(p.injury.severity)
                · 복귀 예정 @Ui.DateLabel(p.injury.expectedReturnDate)
            </span>
        </div>
    }

    <div class="grid grid-4">
        <div class="stat">
            <div class="stat-label">현재 기량 (CA)</div>
            <div class="stat-value accent">@Math.Round(ca)</div>
            <div class="bar mt1"><i style="width:@Ui.CaBar(ca)%"></i></div>
        </div>
        <div class="stat">
            <div class="stat-label">잠재력 (PA)</div>
            <div class="stat-value">@Math.Round(pa)</div>
            <div class="stat-sub">실현율 @((ca / Math.Max(1f, pa) * 100f).ToString("F0"))%</div>
        </div>
        <div class="stat">
            <div class="stat-label">시장 가치</div>
            <div class="stat-value" style="font-size:1.25rem">@Ui.Money(p.marketValue)</div>
            <div class="stat-sub">주급 @Ui.Money(p.contract?.weeklyWage ?? 0)</div>
        </div>
        <div class="stat">
            <div class="stat-label">컨디션 · 사기</div>
            <div class="stat-value" style="font-size:1.25rem">@((int)p.condition)%</div>
            <div class="stat-sub">@Ui.MoraleLabel(p.morale)</div>
        </div>
    </div>

    var tacticRole = TacticRole(w, p);
    var shownRole = ShownRole(w, p);
    var keyDef = shownRole is { } sr ? RoleDatabase.Get(sr) : null;
    var keys = KeySet(keyDef);
    var isGk = (p.positionFlags & Position.GK) != 0;
    <div class="card mt1">
        <div class="card-head">
            <h3>능력치</h3>
            <span class="spacer"></span>
            <span class="tiny dim nowrap"><span class="attr-key-swatch"></span> 역할의 핵심</span>
            <select @bind="RolePick" title="핵심 능력치를 볼 역할">
                @foreach (var (role, fit) in RoleChoices(p, tacticRole))
                {
                    <option value="@role">
                        @RoleDatabase.Get(role).displayName (@fit)@(role == tacticRole ? " · 전술" : "")
                    </option>
                }
            </select>
        </div>
        <div class="attr-grid">
            <section>
                @if (isGk)
                {
                    <h4>골키퍼</h4>
                    @foreach (var a in GkAttrs) { @Attr(a.label, a.get(p), keys.Contains(a.key)) }
                }
                else
                {
                    <h4>기술</h4>
                    @foreach (var a in TechAttrs) { @Attr(a.label, a.get(p), keys.Contains(a.key)) }
                }
            </section>
            <section>
                <h4>정신</h4>
                @foreach (var a in MentalAttrs) { @Attr(a.label, a.get(p), keys.Contains(a.key)) }
            </section>
            <section>
                <h4>신체</h4>
                @foreach (var a in PhysAttrs) { @Attr(a.label, a.get(p), keys.Contains(a.key)) }
                @if (isGk)
                {
                    <h4 class="mt1">기술</h4>
                    @foreach (var a in TechAttrs) { @Attr(a.label, a.get(p), keys.Contains(a.key)) }
                }
            </section>
        </div>
        @if (keyDef is not null)
        {
            <p class="tiny dim mb0 mt1">
                <strong>@keyDef.displayName</strong> — @keyDef.shortDescription
                · 적합도는 강조된 능력치가 본인 평균보다 얼마나 높은지로 셉니다.
            </p>
        }
    </div>

    <div class="grid grid-2">
        <div class="card">
            <div class="card-head"><h3>이번 시즌</h3></div>
            <table class="ft">
                <tbody>
                    <tr><td>출전</td><td class="num">@p.seasonStats.appearances 경기</td></tr>
                    <tr><td>득점 · 도움</td><td class="num">@p.seasonStats.goals · @p.seasonStats.assists</td></tr>
                    <tr><td>평균 평점</td><td class="num">@(p.seasonStats.appearances > 0 ? p.seasonStats.averageRating.ToString("F2") : "—")</td></tr>
                    <tr><td>출전 시간</td><td class="num">@((int)p.seasonStats.minutesPlayed) 분</td></tr>
                    <tr><td>경고 · 퇴장</td><td class="num">@p.seasonStats.yellowCards · @p.seasonStats.redCards</td></tr>
                </tbody>
            </table>
        </div>

        <div class="card">
            <div class="card-head"><h3>계약</h3></div>
            <table class="ft">
                <tbody>
                    <tr><td>주급</td><td class="num">@Ui.Money(p.contract?.weeklyWage ?? 0)</td></tr>
                    <tr><td>만료</td><td class="num">@(p.contract is null ? "—" : Ui.DateLabel(p.contract.expiryDate))</td></tr>
                    <tr><td>성향</td><td class="num">@p.personality</td></tr>
                    <tr><td>프로의식</td><td class="num">@p.hidden.professionalism / 20</td></tr>
                    <tr><td>부상 성향</td><td class="num">@p.hidden.injuryProneness / 20</td></tr>
                    <tr><td>회복력</td><td class="num">@p.hidden.recoveryRate / 20</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    @if (p.clubId == Session.World?.ManagedClubId && Session.GoalsOf(p) is { Count: > 0 } goals)
    {
        <div class="card">
            <div class="card-head">
                <h3>올해 바라는 것</h3>
                <span class="spacer"></span>
                <span class="tiny dim">시즌 @((int)(Session.SeasonProgress * 100))% 진행</span>
            </div>
            <table class="ft">
                <tbody>
                    @foreach (var g in goals)
                    {
                        <tr>
                            <td class="nowrap" style="width:12rem">@g.Text</td>
                            <td style="min-width:90px">
                                <div class="bar @(g.Met ? "good" : "")">
                                    <i style="width:@((int)(g.Ratio * 100))%"></i>
                                </div>
                            </td>
                            <td class="right nowrap tiny" style="width:5rem">
                                @if (g.Met)
                                {
                                    <span class="badge good">이룸</span>
                                }
                                else if (g.Target > 1)
                                {
                                    <span class="dim">@g.Progress / @g.Target</span>
                                }
                                else
                                {
                                    <span class="dim">아직</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="tiny dim">못 이룬 채 시즌이 흐르면 불만이 쌓이고, 끝내 이적을 요청합니다.</p>
        </div>
    }

    @if (p.caps > 0 || Session.IsNationalCandidate(p))
    {
        <div class="card">
            <div class="card-head"><h3>국가대표</h3></div>
            <table class="ft">
                <tbody>
                    <tr><td>국적</td><td class="num"><Flag Of="p.nationality" /> @p.nationality</td></tr>
                    <tr><td>A매치 출전</td><td class="num">@p.caps</td></tr>
                    <tr><td>대표팀 득점</td><td class="num">@p.internationalGoals</td></tr>
                    <tr>
                        <td>발탁선</td>
                        <td class="num">
                            CA @Session.CallUpThreshold(p).ToString("F0")
                            <span class="tiny dim">(현재 @Math.Round(GameWorld.Ca(p)))</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    @if (BestRoles(p) is { Count: > 0 } roles)
    {
        <div class="card">
            <div class="card-head">
                <h3>어울리는 역할</h3>
                <span class="spacer"></span>
                <span class="tiny dim">능력치의 치우침으로 봅니다</span>
            </div>
            <table class="ft">
                <tbody>
                    @foreach (var (role, fit) in roles)
                    {
                        var def = RoleDatabase.Get(role);
                        <tr>
                            <td class="nowrap" style="width:10rem">@def.displayName</td>
                            <td class="tiny dim">@def.shortDescription</td>
                            <td class="right" style="width:3.5rem">
                                <span class="badge @(fit >= 65 ? "good" : fit < 45 ? "warn" : "")">@fit</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (p.clubId == Session.World?.ManagedClubId && Session.RelationsOf(p) is { Count: > 0 } relations)
    {
        <div class="card">
            <div class="card-head">
                <h3>탈의실에서</h3>
                <span class="spacer"></span>
                <a class="tiny" href="room">탈의실 전체 보기</a>
            </div>
            <table class="ft">
                <tbody>
                    @foreach (var rel in relations.Take(6))
                    {
                        <tr>
                            <td class="nowrap" style="width:7rem">@RelName(rel.type)</td>
                            <td class="nowrap">
                                <a href="@($"player/{rel.targetPlayerId}")">
                                    @Session.World!.Player(rel.targetPlayerId)?.FullName
                                </a>
                            </td>
                            <td class="right mono dim tiny">@rel.strength</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a class="btn" href="squad">스쿼드로 돌아가기</a>
}

@code {
    [Parameter] public int Id { get; set; }

    PlayerData? Player => Session.Player(Id);

    /// <summary>그 선수가 소화할 수 있는 자리에서 가장 잘 맞는 역할 다섯 가지.</summary>
    static List<(PlayerRole role, int fit)> BestRoles(PlayerData p)
        => RoleDatabase.All.Values
            .Where(d => (d.applicablePositions & p.positionFlags) != 0)
            .Select(d => (d.role, fit: RoleFit.Percent(p, d)))
            .OrderByDescending(x => x.fit)
            .Take(5)
            .ToList();

    static string RelName(RelationshipType t) => t switch
    {
        RelationshipType.Captain => "주장",
        RelationshipType.Mentor => "멘토",
        RelationshipType.Mentee => "멘티",
        RelationshipType.Rival => "경쟁자",
        RelationshipType.NationalTeam => "동향",
        _ => "동료",
    };

    // ── 능력치 ────────────────────────────────────────────────────────────
    //
    // 막대 없이 숫자와 색 등급만 둔다. 36개가 한 화면에 들어와야 서로 비교된다.
    // 강조는 RoleFit 이 실제로 세는 핵심 능력치 목록 그대로다 — 화면과 계산이 어긋나지 않게.

    PlayerRole? pickedRole;
    int pickedFor;

    string RolePick
    {
        get => Session.World is { } w && Player is { } p ? ShownRole(w, p)?.ToString() ?? "" : "";
        set => pickedRole = Enum.TryParse<PlayerRole>(value, out var r) ? r : null;
    }

    // 다른 선수로 넘어가면 고른 역할을 버린다. 같은 컴포넌트가 재사용되기 때문이다.
    protected override void OnParametersSet()
    {
        if (pickedFor != Id) { pickedRole = null; pickedFor = Id; }
    }

    record AttrDef(object key, string label, Func<PlayerData, int> get);

    static readonly AttrDef[] TechAttrs =
    [
        new(TechnicalAttribute.Passing, "패스", p => p.technical.passing),
        new(TechnicalAttribute.Dribbling, "드리블", p => p.technical.dribbling),
        new(TechnicalAttribute.Shooting, "슈팅", p => p.technical.shooting),
        new(TechnicalAttribute.Finishing, "마무리", p => p.technical.finishing),
        new(TechnicalAttribute.Heading, "헤더", p => p.technical.heading),
        new(TechnicalAttribute.Crossing, "크로스", p => p.technical.crossing),
        new(TechnicalAttribute.Tackling, "태클", p => p.technical.tackling),
        new(TechnicalAttribute.Marking, "마킹", p => p.technical.marking),
        new(TechnicalAttribute.FirstTouch, "퍼스트터치", p => p.technical.firstTouch),
        new(TechnicalAttribute.LongPassing, "롱패스", p => p.technical.longPassing),
        new(TechnicalAttribute.SetPieces, "세트피스", p => p.technical.setPieces),
    ];

    static readonly AttrDef[] MentalAttrs =
    [
        new(MentalAttribute.Vision, "시야", p => p.mental.vision),
        new(MentalAttribute.Composure, "침착", p => p.mental.composure),
        new(MentalAttribute.Leadership, "리더십", p => p.mental.leadership),
        new(MentalAttribute.Courage, "투지", p => p.mental.courage),
        new(MentalAttribute.WorkRate, "활동량", p => p.mental.workRate),
        new(MentalAttribute.Concentration, "집중", p => p.mental.concentration),
        new(MentalAttribute.Decisions, "판단", p => p.mental.decisions),
        new(MentalAttribute.Positioning, "위치선정", p => p.mental.positioning),
        new(MentalAttribute.Aggression, "적극성", p => p.mental.aggression),
        new(MentalAttribute.Teamwork, "팀워크", p => p.mental.teamwork),
        new(MentalAttribute.OffTheBall, "오프더볼", p => p.mental.offTheBall),
    ];

    static readonly AttrDef[] PhysAttrs =
    [
        new(PhysicalAttribute.Speed, "속도", p => p.physical.speed),
        new(PhysicalAttribute.Acceleration, "가속", p => p.physical.acceleration),
        new(PhysicalAttribute.Stamina, "체력", p => p.physical.stamina),
        new(PhysicalAttribute.Strength, "몸싸움", p => p.physical.strength),
        new(PhysicalAttribute.Jumping, "점프", p => p.physical.jumping),
        new(PhysicalAttribute.Agility, "민첩", p => p.physical.agility),
        new(PhysicalAttribute.Balance, "밸런스", p => p.physical.balance),
    ];

    static readonly AttrDef[] GkAttrs =
    [
        new(GkAttribute.Handling, "핸들링", p => p.goalkeeper.handling),
        new(GkAttribute.Diving, "다이빙", p => p.goalkeeper.diving),
        new(GkAttribute.Reflexes, "반사신경", p => p.goalkeeper.reflexes),
        new(GkAttribute.Positioning, "위치선정", p => p.goalkeeper.positioning),
        new(GkAttribute.CommandArea, "커맨드", p => p.goalkeeper.commandArea),
        new(GkAttribute.OneOnOne, "일대일", p => p.goalkeeper.oneOnOne),
        new(GkAttribute.AerialAbility, "제공권", p => p.goalkeeper.aerialAbility),
        new(GkAttribute.Kicking, "킥", p => p.goalkeeper.kicking),
        new(GkAttribute.Throwing, "스로", p => p.goalkeeper.throwing),
        new(GkAttribute.Communication, "소통", p => p.goalkeeper.communication),
    ];

    /// <summary>강조할 역할: 고른 것 → 전술에서 맡은 것 → 가장 잘 맞는 것.</summary>
    PlayerRole? ShownRole(GameWorld w, PlayerData p)
        => pickedRole ?? TacticRole(w, p) ?? BestRoles(p).Select(x => (PlayerRole?)x.role).FirstOrDefault();

    static HashSet<object> KeySet(RoleDefinition? def)
    {
        var set = new HashSet<object>();
        if (def is null) return set;
        foreach (var a in def.keyTechnicalAttributes ?? []) set.Add(a);
        foreach (var a in def.keyMentalAttributes ?? []) set.Add(a);
        foreach (var a in def.keyPhysicalAttributes ?? []) set.Add(a);
        foreach (var a in def.keyGkAttributes ?? []) set.Add(a);
        return set;
    }

    /// <summary>소속 구단의 현재 전술에서 이 선수가 맡은 역할. 선발이 아니면 null.</summary>
    static PlayerRole? TacticRole(GameWorld w, PlayerData p)
    {
        var club = w.Club(p.clubId);
        var tac = club?.savedTactics.FirstOrDefault(t => t.id == club.activeTacticsId);
        return tac?.slots.FirstOrDefault(s => s.assignedPlayerId == p.id)?.role?.role;
    }

    /// <summary>고를 수 있는 역할: 전술에서 맡은 역할 + 잘 맞는 다섯.</summary>
    static List<(PlayerRole role, int fit)> RoleChoices(PlayerData p, PlayerRole? tacticRole)
    {
        var list = BestRoles(p);
        if (tacticRole is { } tr && list.All(x => x.role != tr))
            list.Insert(0, (tr, RoleFit.Percent(p, RoleDatabase.Get(tr))));
        return list;
    }

    static string Grade(int v) => v >= 16 ? "g4" : v >= 11 ? "g3" : v >= 6 ? "g2" : "g1";

    RenderFragment Attr(string name, int value, bool key) => @<div class="attr-cell @(key ? "key" : "")">
        <span class="name">@name</span>
        <span class="val @Grade(value)">@value</span>
    </div>;
}
