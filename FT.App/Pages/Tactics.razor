    {
        if (Session.ActiveTactics is { } t && int.TryParse(value?.ToString(), out int v))
            t.instructions.mentality = (TeamMentality)Math.Clamp(v, 0, 4);
        await Session.TouchAsync();
    }

    async Task SetLine(object? value)
    {
        if (Session.ActiveTactics is { } t && int.TryParse(value?.ToString(), out int v))
            t.instructions.defensiveLine = (DefensiveLine)Math.Clamp(v, 0, 4);
        await Session.TouchAsync();
    }

    async Task SetBuildUp(object? value)
    {
        if (Session.ActiveTactics is { } t && int.TryParse(value?.ToString(), out int v))
            t.instructions.buildUpStyle = (BuildUpStyle)Math.Clamp(v, 0, 3);
        await Session.TouchAsync();
    }

    async Task Set(Action<int> apply, object? value)
    {
        if (int.TryParse(value?.ToString(), out int v)) apply(v);
        await Session.TouchAsync();
    }

    async Task Toggle(Action<bool> apply, object? value)
    {
        apply(value is bool b ? b : bool.TryParse(value?.ToString(), out var p) && p);
        await Session.TouchAsync();
    }
