        <= 2 => "체력을 아끼지만 상대가 편하게 공을 돌립니다",
        _ => "체력 소모 없이 무난합니다",
    };

    static string TempoNote(int tempo) => tempo switch
    {
        >= 5 => "슈팅이 늘지만 하나하나의 질이 떨어지고 체력을 씁니다",
        4 => "조금 더 많이, 조금 더 급하게 때립니다",
        <= 2 => "적게 때리는 대신 좋은 기회를 고릅니다",
        _ => "균형잡힌 속도입니다",
    };

    static string WidthNote(int width) => width switch
    {
        >= 4 => "내려선 상대를 벌리기 좋지만 올라온 상대에게는 헛돕니다",
        <= 2 => "올라온 상대의 사이를 찌르기 좋지만 내려선 상대는 못 벌립니다",
