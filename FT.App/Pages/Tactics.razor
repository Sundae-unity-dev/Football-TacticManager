    static string LineNote(DefensiveLine line) => line switch
    {
        DefensiveLine.VeryHigh => "공을 많이 쥐지만 뒷공간을 크게 내줍니다",
        DefensiveLine.High => "중원을 압축하는 대신 뒷공간이 조금 열립니다",
        DefensiveLine.Low => "뒷공간을 지키지만 공을 내주고 상대 슈팅이 줄어듭니다",
        DefensiveLine.VeryLow => "뒷공간을 거의 안 주지만 공격으로 나가기 어렵습니다",
        _ => "무난한 높이입니다",
    };

    static string BuildUpNote(BuildUpStyle style) => style switch
    {
        BuildUpStyle.ShortPassing => "공을 쥐고 좋은 기회를 만들지만 압박에 끊깁니다",
        BuildUpStyle.LongBall => "압박을 넘기지만 공을 내주고 기회의 질이 떨어집니다",
        BuildUpStyle.Direct => "빅찬스가 늘지만 점유율과 기회의 질을 내줍니다",
        _ => "치우치지 않습니다",
    };

    string TrapNote()
    {
        var club = Session.World?.MyClub;
        var tac = Session.ActiveTactics;
        if (Session.World is null || tac is null) return "수비수가 잘 맞춰야 이득입니다";

        float skill = TacticalProfile.TrapSkill(
            tac.slots.Select(s => Session.World.Player(s.assignedPlayerId)).ToArray());

        return skill >= BalanceConfig.TrapBreakEven
            ? $"수비진 숙련 {skill:F0} — 걸 만합니다 (본전 {BalanceConfig.TrapBreakEven:F0})"
            : $"수비진 숙련 {skill:F0} — 못 맞추면 뒷공간이 되레 열립니다 (본전 {BalanceConfig.TrapBreakEven:F0})";
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var club = Session.World?.MyClub;
        var tac = Session.ActiveTactics;
        if (tac is not null)
        {
            // 저장된 전술의 프리셋 id 를 모양으로 역추적한다.
            var match = FormationDatabase.All.FirstOrDefault(p => p.shape == tac.formationShape);
            formation = match?.id ?? "4-2-3-1";
        }
    }

    static FormationSlot? SlotOf(TacticsData tac, int index)
        => tac.slots.FirstOrDefault(s => s.slotIndex == index);

    void SelectSlot(int index)
    {
        selectedSlot = selectedSlot == index ? -1 : index;
    }

    async Task ResetLineup()
    {
        Session.ResetLineup();
        selectedSlot = -1;
        await Session.TouchAsync();
    }

    async Task ChangeFormation()
    {
        Session.SetFormation(formation);
        selectedSlot = -1;
        await Session.TouchAsync();
    }

    async Task Assign(int playerId)
    {
        if (selectedSlot < 0) return;
        Session.AssignToSlot(selectedSlot, playerId);
        selectedSlot = -1;
        await Session.TouchAsync();
    }

    IEnumerable<PlayerData> Candidates(Position slot)
        => Session.Squad
            .OrderByDescending(p => LineupBuilder.Fit(p, slot))
            .ThenByDescending(GameWorld.Ca)
            .Take(12);

    // 배치 계산과 같은 판정을 쓴다. 따로 구현하면 표시와 실제 적합도가 어긋난다.
    static string FitLabel(PlayerData p, Position slot) => LineupBuilder.Tier(p, slot) switch
    {
        LineupBuilder.FitTier.Natural => "적합",
        LineupBuilder.FitTier.Related => "소화 가능",
        LineupBuilder.FitTier.Impossible => "불가",
        _ => "낯섦",
    };

    static string FitBadge(PlayerData p, Position slot) => LineupBuilder.Tier(p, slot) switch
    {
        LineupBuilder.FitTier.Natural => "good",
        LineupBuilder.FitTier.Related => "",
        LineupBuilder.FitTier.Impossible => "bad",
        _ => "warn",
    };

