@page "/table"
@inherits SessionPage

<PageTitle>순위표 · Football Tactician</PageTitle>

@if (Session.World is not { } w)
{
    <Redirect />
}
else
{
    var league = w.League(viewLeagueId > 0 ? viewLeagueId : w.MyLeague!.id)!;
    var season = league.currentSeason;

    <h1>순위표</h1>

    <div class="card">
        <div class="card-head">
            <h3>@league.name</h3>
            <span class="spacer"></span>
            <select @bind="viewLeagueId" @bind:after="StateHasChanged">
                @foreach (var n in w.Nations)
                {
                    @foreach (var lid in n.LeagueIds)
                    {
                        var l = w.League(lid)!;
                        <option value="@lid">@n.Country — @l.name (@((int)l.tier)부)</option>
                    }
                }
            </select>
        </div>

        @{
            var poTeams = ChampionPlayoff.EntrantsFor(w, league);

            // ⑦ 한 해를 둘로 가르는 리그는 보고 있는 단계가 따로 있다.
            bool twoStage = TwoStage.Has(season);
            int stage = twoStage ? (stageChoice ?? TwoStage.CurrentStage(season)) : TwoStage.Apertura;
            var rows = !twoStage ? season.standings
                     : stage == Aggregate ? TwoStage.SeasonTable(league)
                     : TwoStage.StageTable(league, stage);
        }

        @if (twoStage)
        {
            <p class="tiny" style="color:var(--sky)">
                이 리그는 <strong>한 해에 우승팀이 둘</strong>입니다 —
                1~@(season.stageMatchday)라운드가 아페르투라,
                @(season.stageMatchday + 1)~@(season.totalMatchdays)라운드가 클라우수라이고
                순위표를 각각 처음부터 셉니다.
                <strong>강등은 한 해 합산</strong>으로 정합니다.
                @if (season.aperturaChampionClubId > 0)
                {
                    <span>
                        올해 아페르투라 우승은
                        <ClubLink Id="season.aperturaChampionClubId" /> 였습니다.
                    </span>
                }
            </p>

            <div class="btn-row" style="margin-bottom:.7rem">
                @foreach (var (label, value) in new[]
                          {
                              ("아페르투라", TwoStage.Apertura),
                              ("클라우수라", TwoStage.Clausura),
                              ("한 해 합산", Aggregate),
                          })
                {
                    <button class="btn btn-sm @(stage == value ? "btn-primary" : "")"
                            @onclick="() => stageChoice = value">@label</button>
                }
            </div>
        }
        @if (poTeams >= 2)
        {
            <p class="tiny" style="color:var(--sky)">
                이 리그는 <strong>정규리그 1위가 우승이 아닙니다</strong> —
                상위 @(poTeams)팀이 시즌 뒤에 챔피언 결정전을 치릅니다.
                1위에게는 정규리그 우승의 몫이 따로 돌아갑니다.
                @if (league.lastChampionClubId > 0)
                {
                    <span>
                        지난 @league.lastChampionYear 시즌 우승은
                        <ClubLink Id="league.lastChampionClubId" /> 였습니다.
                    </span>
                }
            </p>
        }

        @if (season.splitMatchday > 0)
        {
            <p class="tiny" style="color:var(--amber)">
                @season.splitMatchday 라운드에 상·하위로 갈렸습니다.
                같은 조끼리만 치르고, <strong>아래 조는 위 조를 넘어설 수 없습니다</strong>
                — 승점이 더 많아도 그렇습니다.
            </p>
        }

        <p class="tiny dim">
            @season.currentMatchday / @season.totalMatchdays 라운드 ·
            <span style="color:var(--emerald)">■</span> @(league.tier == LeagueTier.First ? "우승권" : "승격권")
            @if (league.tier == LeagueTier.First)
            {
                <span><span style="color:var(--sky)">■</span> 대륙 대회</span>
                @* 닫힌 리그에는 강등이 없다(③) — 범례에만 남아 있으면 거짓말이 된다. *@
                @if (league.relegationSpots > 0)
                {
                    <span><span style="color:var(--coral)">■</span> 강등권</span>
                }
            }
        </p>

        <div style="overflow-x:auto">
            <table class="ft">
                <thead>
                    <tr>
                        <th>#</th><th>구단</th>
                        <th class="num">경기</th><th class="num">승</th><th class="num">무</th><th class="num">패</th>
                        <th class="num">득</th><th class="num">실</th><th class="num">득실</th><th class="num">승점</th>
                        <th>최근</th><th class="num">전력</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in rows)
                    {
                        @if (SplitStartsHere(season, e))
                        {
                            <tr class="split-line">
                                <td colspan="12" class="tiny dim">
                                    여기서부터 하위 조 — 위 조와는 더 겨루지 않습니다
                                </td>
                            </tr>
                        }
                        @if (poTeams >= 2 && e.position == poTeams + 1)
                        {
                            <tr class="split-line">
                                <td colspan="12" class="tiny dim">
                                    여기까지가 챔피언 결정전 진출 — 아래로는 시즌이 끝납니다
                                </td>
                            </tr>
                        }
                        <tr class="@RowClass(e, league)">
                            <td class="mono">@e.position</td>
                            <td class="nowrap">
                                <ClubLink Id="e.clubId" Kit="true" />
                            </td>
                            <td class="num">@e.played</td>
                            <td class="num">@e.won</td>
                            <td class="num">@e.drawn</td>
                            <td class="num">@e.lost</td>
                            <td class="num">@e.goalsFor</td>
                            <td class="num">@e.goalsAgainst</td>
                            <td class="num">@e.GoalDifference.ToString("+0;-0;0")</td>
                            <td class="num"><strong>@e.points</strong></td>
                            <td class="nowrap">
                                @foreach (var c in Standings.RecentForm(league, e.clubId))
                                {
                                    <span class="form-dot form-@c">@c</span>
                                }
                            </td>
                            <td class="num dim">@Math.Round(w.Strength(e.clubId))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    int viewLeagueId;

    /// <summary>⑦ 순위표에서 "한 해 합산"을 고른 경우.</summary>
    const int Aggregate = -1;

    /// <summary>골라 둔 단계. null 이면 지금 치르고 있는 단계를 보여 준다.</summary>
    int? stageChoice;

    // 구단 화면의 리그 이름은 table?league={id}로 온다.
    [SupplyParameterFromQuery(Name = "league")] public int? LeagueId { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        viewLeagueId = Session.World?.MyLeague?.id ?? 0;
    }

    protected override void OnParametersSet()
    {
        if (LeagueId is { } id && Session.World?.League(id) != null) viewLeagueId = id;
    }

    /// <summary>그 줄 바로 앞에 하위 조 경계선을 그릴지.</summary>
    static bool SplitStartsHere(LeagueSeason season, StandingEntry e)
        => season.splitMatchday > 0
           && LeagueSplit.GroupOf(season, e.clubId) == 1
           && season.standings
                    .TakeWhile(x => x.clubId != e.clubId)
                    .All(x => LeagueSplit.GroupOf(season, x.clubId) == 0);

    string RowClass(StandingEntry e, LeagueData league)
    {
        var cls = e.clubId == Session.World!.ManagedClubId ? "me " : "";
        int n = league.clubIds.Count;

        // 2부는 승격권이 상위, 강등권이 없다.
        if (league.tier != LeagueTier.First)
            return e.position <= league.promotionSpots ? cls + "zone-champ" : cls;

        if (e.position == 1) return cls + "zone-champ";
        if (e.position <= 4) return cls + "zone-euro";

        // 강등은 꼴찌에서 센다 — 스플릿이든 아니든 결국 맨 아래가 내려간다.
        if (league.relegationSpots > 0 && e.position > n - league.relegationSpots)
            return cls + "zone-releg";
        return cls;
    }
}
