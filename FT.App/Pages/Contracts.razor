@page "/contracts"
@inherits SessionPage

<PageTitle>계약 · Football Tactician</PageTitle>

@if (Session.World is not { } w || w.MyClub is not { } club)
{
    <Redirect />
}
else
{
    var expiring = Session.ExpiringContracts.ToList();
    var urgent = expiring.Count(p => Session.MonthsLeft(p) <= 6);

    <h1>계약</h1>
    <p class="muted">
        @club.name · 주급 합계 @Ui.Money(club.finances.currentWageSpend)/주 ·
        급여 비중 @((club.finances.currentWageSpend * 52f / Math.Max(1, club.finances.annualRevenue)).ToString("P0"))
    </p>

    @if (urgent > 0)
    {
        <div class="card" style="border-color:var(--coral)">
            <strong style="color:var(--coral)">@(urgent)명의 계약이 6개월 안에 끝납니다.</strong>
            <span class="muted">재계약하지 않으면 시즌이 끝날 때 이적료 없이 떠납니다.</span>
        </div>
    }

    <div class="card">
        <div class="card-head">
            <h3>만료가 가까운 선수</h3>
            <span class="spacer"></span>
            <span class="tiny dim">@(expiring.Count)명 · 18개월 이내</span>
        </div>

        @if (expiring.Count == 0)
        {
            <div class="empty">당분간 만료되는 계약이 없습니다.</div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="ft">
                    <thead>
                        <tr>
                            <th>선수</th><th>포지션</th><th class="num">나이</th><th class="num">CA</th>
                            <th class="num">남은 기간</th><th class="num">현재 주급</th>
                            <th class="num">요구 주급</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in expiring)
                        {
                            var months = Session.MonthsLeft(p);
                            var want = ContractTalks.DemandedWage(w, p);
                            var now = p.contract?.weeklyWage ?? 0;
                            <tr class="@(talks?.playerId == p.id ? "me" : "")">
                                <td class="nowrap">
                                    <a href="@($"player/{p.id}")">@p.FullName</a>
                                </td>
                                <td><span class="badge pos @Ui.PosClassOf(p)">@Ui.PosLabelOf(p)</span></td>
                                <td class="num">@w.Age(p)</td>
                                <td class="num">@Math.Round(GameWorld.Ca(p))</td>
                                <td class="num">
                                    <span class="badge @(months <= 6 ? "bad" : months <= 12 ? "warn" : "")">
                                        @(months)개월
                                    </span>
                                </td>
                                <td class="num dim">@Ui.Money(now)</td>
                                <td class="num">
                                    @Ui.Money(want)
                                    @if (want > now)
                                    {
                                        <span class="tiny dim">(+@((want / (float)Math.Max(1, now) - 1).ToString("P0")))</span>
                                    }
                                </td>
                                <td class="right">
                                    <button class="btn btn-sm" @onclick="() => Select(p)">재계약</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (talks is { } t)
    {
        <div @ref="talksAnchor" tabindex="-1" class="focus-anchor"></div>
        <ContractTable Talks="t"
                       Offer="offer"
                       Blocker="@Blocker"
                       Title="@($"{Session.NameOf(t.playerId)} 재계약")"
                       SignLabel="재계약 체결"
                       MaxWage="MaxWage"
                       OnPropose="Propose"
                       OnFill="Fill"
                       OnSign="Sign"
                       OnClose="Close" />
    }

    <div class="card">
        <div class="card-head"><h3>전체 계약 현황</h3></div>
        <table class="ft">
            <thead><tr><th>선수</th><th class="num">CA</th><th class="num">주급</th><th class="num">만료</th><th class="num">남은 기간</th></tr></thead>
            <tbody>
                @foreach (var p in Session.Squad.OrderBy(p => p.contract?.expiryDate ?? default))
                {
                    var months = Session.MonthsLeft(p);
                    <tr>
                        <td class="nowrap">@p.FullName</td>
                        <td class="num">@Math.Round(GameWorld.Ca(p))</td>
                        <td class="num">@Ui.Money(p.contract?.weeklyWage ?? 0)</td>
                        <td class="num tiny dim">@(p.contract is null ? "—" : Ui.DateLabel(p.contract.expiryDate))</td>
                        <td class="num">
                            <span class="badge @(months <= 6 ? "bad" : months <= 12 ? "warn" : "")">@(months)개월</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    // 협상 탁자는 화면이 들고 있다. 세계에는 합의한 계약서만 남는다.
    ContractNegotiation.Talks? talks;
    ContractNegotiation.Terms offer = new();

    // 선수 화면·목록의 [재계약]은 contracts?player={id}로 온다. 그 선수의 탁자를 바로 연다.
    [SupplyParameterFromQuery(Name = "player")] public int? PlayerId { get; set; }
    int? openedFromQuery;
    ElementReference talksAnchor;
    bool scrollToTalks;

    protected override void OnParametersSet()
    {
        if (PlayerId is not { } id || id == openedFromQuery) return;
        openedFromQuery = id;
        if (Session.World is { } w && Session.Player(id) is { } p && p.clubId == w.ManagedClubId)
            Select(p);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToTalks || talks is null) return;
        scrollToTalks = false;
        await talksAnchor.FocusAsync(preventScroll: false);
    }

    int MaxWage => Math.Max(20_000, (int)((Session.World?.MyClub?.finances.annualRevenue ?? 0) / 52 / 3));

    string? Blocker => talks is null || Session.World is not { } w
        ? null
        : ContractNegotiation.ClubBlocker(w, talks, offer);

    void Select(PlayerData p)
    {
        talks = Session.OpenRenewal(p);
        offer = talks is null ? new() : ContractNegotiation.Suggest(talks);
        scrollToTalks = talks is not null;
    }

    void Fill()
    {
        if (talks is { } t) offer = ContractNegotiation.Suggest(t);
    }

    void Propose()
    {
        if (talks is { } t) Session.Propose(t, offer);
    }

    async Task Sign()
    {
        if (talks is not { agreed: true } t) return;
        await Session.SignRenewalAsync(t, offer);
        talks = null;
    }

    void Close() => talks = null;
}
