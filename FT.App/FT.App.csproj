<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!--
      올라간 버전. 여기 한 줄만 고치면 시작 화면 구석까지 따라갑니다(Ui.Version).

      왜 화면에 찍는가: Pages 는 파일을 캐시합니다. 고친 것이 정말 올라갔는지
      새로고침해서 눈으로 보는 편이 Actions 로그를 뒤지는 것보다 빠릅니다.
      올릴 때는 CHANGELOG.md 에 한 칸 쓰고 git tag 를 같이 밀어 주세요.
    -->
    <Version>0.15.1</Version>

    <!--
      트리밍을 켠다. 끄면 쓰지도 않는 BCL 이 통째로 실려 내려받기가 8.0MB 가 된다
      (켜면 2.8MB · 파일 204 → 41개).

      세이브는 소스 생성 리졸버(SaveJsonContext)로 읽고 쓰므로 트리머가 지울 것이 없다.
      다만 다루지 못하는 타입은 리플렉션 리졸버가 받으므로, 안전은 운에 맡기지 않고
      아래 TrimmerRootAssembly 로 FT.Core 를 통째로 남긴다 — 모델 타입이 전부 여기에 있다.
      (FT.Core 원본은 890KB 라, 남겨도 줄어드는 양의 대부분은 그대로 얻는다.)
    -->
    <PublishTrimmed>true</PublishTrimmed>

    <!--
      AOT 로 미리 컴파일한다. 브라우저의 기본 런타임은 IL 을 해석해서 도는데,
      이 게임은 저장 한 번에 멤버를 수십만 번 쓴다 — 해석 비용이 그대로 기다리는 시간이다.

        저장 JSON  350ms → 108ms      라운드 150ms → 73ms      세계 생성 365ms → 275ms
        내려받기   2.81MB → 5.15MB    (처음 한 번. 그 뒤로는 브라우저가 캐시한다)

      publish 할 때만 돈다. dotnet run 으로 개발할 때는 영향이 없다.
      대신 배포 빌드가 40초에서 20분쯤으로 길어진다 — CI 를 붙일 때 염두에 둘 것.
    -->
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <!-- 세이브가 이름으로 찾는 타입이 있으므로 규칙만으로 지우게 두지 않는다. -->
    <TrimmerRootAssembly Include="FT.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.6" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FT.Core\FT.Core.csproj" />
  </ItemGroup>

</Project>
